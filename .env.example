# Copy to .env for local use. Never commit .env or put real values in this file.
APP_ENV=development

# Required whenever APP_ENV is not "development" (and always on Railway).
APP_USERNAME=
APP_PASSWORD=
APP_SECRET_KEY=

# Optional: enables AI analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional, local/trusted use only.
ENABLE_SELENIUM=false
