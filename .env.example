# Copy to .env for local use. Never commit .env or put real values in this file.
APP_ENV=development
APP_MODE=private

# Required in production. Use separate values for the private service.
APP_SECRET_KEY=
DATABASE_URL=sqlite:///webscrapeai.sqlite3
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Set only to the verified number of trusted reverse-proxy hops; default ignores forwarded IP headers.
TRUSTED_PROXY_HOPS=0

# Required to enable private password-reset email; use the canonical HTTPS origin with no path.
PASSWORD_RESET_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=

# Optional when the SMTP provider does not require authentication.
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional: enables AI analysis.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional, local/trusted use only.
ENABLE_SELENIUM=false
